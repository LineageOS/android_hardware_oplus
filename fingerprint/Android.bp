cc_library_static {
    name: "libudfps_extension.oplus",
    srcs: ["UdfpsExtension.cpp"],
    include_dirs: [
        "frameworks/native/services/surfaceflinger/CompositionEngine/include",
    ],
    header_libs: [
        "generated_kernel_headers",
    ],
    cflags: select(soong_config_variable("OPLUS_LINEAGE_UDFPS_EXT", "SKIP_OPLUS_DIMLAYER_ZORDER"), {
        "true": ["-DSKIP_OPLUS_DIMLAYER_ZORDER=true"],
        default: [],
    }),
}
