cc_library {
    name: "libshims_fingerprint.oplus",
    srcs: ["shims/BiometricsFingerprintShim.cpp"],
    shared_libs: [
        "libcutils",
        "liblog",
    ],
    device_specific: true,
}

cc_library_shared {
    name: "libshims_aidl_fingerprint.oplus",
    srcs: ["shims/SensorPropsShim.cpp"],
    shared_libs: ["libbase"],
    static_libs: select(soong_config_variable("OPLUS_BIOMETRICS_FINGERPRINT_AIDL_HAL", "AIDL_INTERFACE_VERSION"), {
        any @ flag_val: ["android.hardware.biometrics.fingerprint-" + flag_val + "-ndk"],
        default: ["android.hardware.biometrics.fingerprint-V4-ndk"],
    }),
    device_specific: true,
}

cc_library_static {
    name: "libudfps_extension.oplus",
    srcs: ["UdfpsExtension.cpp"],
    include_dirs: [
        "frameworks/native/services/surfaceflinger/CompositionEngine/include",
    ],
    header_libs: [
        "generated_kernel_headers",
    ],
}
