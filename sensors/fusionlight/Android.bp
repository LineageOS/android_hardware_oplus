cc_library_shared {
    name: "sensors.fusionlight",
    defaults: ["hidl_defaults"],
    srcs: [
        "CwbSampler.cpp",
        "FusionLightUtils.cpp",
        "FusionLightProcessor.cpp",
        "SensorsSubHal.cpp",
    ],
    shared_libs: [
        "android.hardware.sensors@2.0",
        "android.hardware.sensors@2.0-ScopedWakelock",
        "android.hardware.sensors@2.1",
        "android.hardware.common-V2-ndk",
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "libhidlbase",
        "libjsoncpp",
        "libui",
        "libutils",
        "vendor.oplus.hardware.displaypanelfeature-V1-ndk",
        "vendor.oplus.hardware.oplusSensor-V1-ndk",
        "vendor.qti.hardware.display.config-V12-ndk",
    ],
    static_libs: [
        "libaidlcommonsupport",
    ],
    header_libs: [
        "android.hardware.sensors@2.X-multihal.header",
        "libeigen",
        "libhardware_headers",
    ],
    cflags: [
        "-DLOG_TAG=\"sensors.fusionlight\"",
    ] + select(soong_config_variable("OPLUS_SENSORS_FUSIONLIGHT", "BACKEND_SUBHAL_LIB_NAME"), {
        any @ flag_val: ["-DBACKEND_SUBHAL_LIB_NAME=\"" + flag_val + "\""],
        default: [],
    }),
    vendor: true,
}
