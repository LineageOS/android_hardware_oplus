binder_call(hal_graphics_composer_default, hal_graphics_composer_default)

hal_client_domain(hal_graphics_composer_default, vendor_hal_dolby_dvs)
hal_client_domain(hal_graphics_composer_default, vendor_hal_feature_iris)
hal_server_domain(hal_graphics_composer_default, vendor_hal_display_iris)

hal_attribute_service(vendor_hal_display_iris, hal_display_iris_aidl_service)
binder_call(vendor_hal_display_iris_client, vendor_hal_display_iris_server)
binder_call(vendor_hal_display_iris_server, vendor_hal_display_iris_client)

add_service(hal_graphics_composer_default, hal_oplus_cwb_aidl_service)
add_service(hal_graphics_composer_default, hal_oplus_display_mixlut3d_service)
add_service(hal_graphics_composer_default, hal_oplus_displaycolor_aidl_service)

allow hal_graphics_composer_default fwk_sensor_service:service_manager find;

allow hal_graphics_composer_default vendor_proc_display:file r_file_perms;

set_prop(hal_graphics_composer_default, system_oplus_iris_prop)
get_prop(hal_graphics_composer_default, system_oplus_project_prop)
set_prop(hal_graphics_composer_default, vendor_display_prop)
