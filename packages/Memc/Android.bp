android_app {
    name: "OplusMemc",
    defaults: ["SettingsLibDefaults"],

    srcs: ["src/**/*.kt"],

    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,
    privileged: true,
    privapp_allowlist: "org.lineageos.settings.memc.xml",

    static_libs: [
        "//hardware/pixelworks/interfaces:vendor.pixelworks.hardware.display-V2-java",
        "androidx.preference_preference",
        "org.lineageos.settings.resources",
    ],

    optimize: {
        optimize: true,
        proguard_flags_files: ["proguard.flags"],
        shrink_resources: true,
    },
}
